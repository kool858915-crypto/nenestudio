PORT=8787
APP_BASE_URL=http://localhost:8787
PUBLIC_APP_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:8787

# 本番 (nenestudio.net) の例:
# APP_BASE_URL=https://api.nenestudio.net
# PUBLIC_APP_URL=https://nenestudio.net
# CORS_ORIGIN=https://nenestudio.net,https://nenestudio.pages.dev
JWT_SECRET=change-this-long-random-secret
DATABASE_PATH=./server/nene-studio-db.json
REQUIRE_PERSISTENT_DB=false
COOKIE_DOMAIN=

# Stripe secrets stay on the server.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_PRICE_ID_ADFREE=price_xxx
STRIPE_PRICE_ID_AI50=price_xxx
STRIPE_PRICE_ID_AI100=price_xxx

# OpenAI / Gemini keys stay on the server only (never in published HTML).
OPENAI_API_KEY=sk-proj-xxx
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 公開ツールのURL基盤（DNSで tools.nenestudio.net をAPIと同じオリジンへ）
TOOLS_PUBLIC_BASE_URL=https://tools.nenestudio.net
PUBLIC_API_URL=https://api.nenestudio.net

# Social login（Google Cloud Console で OAuth クライアント ID を作成）
# 手順: DEPLOYMENT.md の「Google ログイン設定」を参照
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
