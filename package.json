{
  "name": "nene-studio-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build:static": "node scripts/build-static.mjs",
    "verify:static": "node scripts/verify-static-build.mjs",
    "verify:zip": "node scripts/verify-zip.mjs",
    "predeploy:cloudflare": "npm run build:static && npm run verify:static",
    "check": "node --check script.js && node --check server/index.js && node scripts/check-cache-version.mjs",
    "test:tool": "node scripts/_test_tool_v2.mjs",
    "test:categories": "node scripts/_test_all_categories.mjs",
    "test:zip": "node scripts/_test_zip_output.mjs",
    "test:parse": "node scripts/_test_parse_and_shot.mjs",
    "test:ads": "node scripts/_test_ads.mjs",
    "test:download": "node scripts/_test_download_flow.mjs",
    "test:zipcontents": "node scripts/_test_zip_contents.mjs",
    "verify:live": "node scripts/_verify_live_ai.mjs",
    "test:all": "npm run check && npm run test:tool && npm run test:categories && npm run test:zip && npm run test:parse && node scripts/_test_export_pipeline.mjs",
    "test:server": "npm run test:download && npm run test:zipcontents",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:dns": "node scripts/verify-dns.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "test:stripe": "node scripts/test-stripe-payment.mjs",
    "setup:stripe": "node scripts/setup-stripe.mjs"
  },
  "dependencies": {
    "apple-signin-auth": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
